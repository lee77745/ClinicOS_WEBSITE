# ClinicOS website — contact form → LINE Messaging API
# Copy to .env locally, and set the same keys in Render Environment Variables.
# Never commit real values.

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CONTACT_TARGET_ID=

# Local server port. Render supplies PORT automatically — do not pin it there.
PORT=3000

# Public origin, e.g. https://www.clinicos.com (reserved; no CORS needed —
# the site and the API are served from the same origin).
SITE_ORIGIN=

# Setup aid only. Set to 1 temporarily to print the FULL LINE source id to the
# server log when a webhook event arrives, so you can copy it into
# LINE_CONTACT_TARGET_ID. Remove it again once you have the id.
# Leave empty/unset in production — ids are masked in the log by default.
LINE_WEBHOOK_REVEAL_ID=
